  "scripts": [
    {
      "id": "counter-script",
      "name": "cycle_counter.c",
      "source": "/* QuickGUI C SDK — compile and run in an isolated worker.\n * The same C source is used for preview and native release builds. */\n#include \"quickgui.h\"\n\nvoid qg_process(void) {\n    double next = qg_input_number() + 1.0;\n    qg_set_number(\"cycles\", next);\n    qg_state_set(\"last_value\", next);\n    qg_log(\"Cycle completed\");\n    qg_emit_number(next);\n}\n",
      "timeoutMs": 1000
    }
  ],
